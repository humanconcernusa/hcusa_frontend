# Dev server port. The API runs on 3010, so the site keeps its own port.
# Copy this file to .env.local and change it if you need to.
PORT=3011

# Build-time values for the public site. Anything here ends up in the exported files.

# Where the donation popups' amounts and purposes come from (the donation platform's API, no
# trailing slash). The popup fetches this in the browser when it opens, so that API must allow
# this site's origin. Set it before `npm run build` — Next bakes it in.
# Example: https://donation.api.progressivebyte.com
NEXT_PUBLIC_DONATION_API_URL=

# Where uploaded images are served from (the R2 public base, no trailing slash). The image
# loader picks the right size from this. Set it before `npm run build` — Next bakes it in.
# Example: https://media.humanconcernusa.org
NEXT_PUBLIC_MEDIA_URL=

# No Stripe key here on purpose. The card fields load with the publishable key the donation
# platform hands out at runtime (src/stripe-key.ts), so nothing Stripe-related is baked into the
# exported files — a key compiled in would be public the day it is wrong.
