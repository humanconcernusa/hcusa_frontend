# Security headers for the exported site.
#
# The Content-Security-Policy lists the addresses the live site talks to. The donation API
# origin must be in connect-src or the donate form is blocked. Add any host that serves
# images to img-src (remote media) or leave only 'self' when images are local. Stripe needs
# script-src and frame-src; its own telemetry lives on r.stripe.com.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pub-387995532fb34284b3f927edc6088b7b.r2.dev; font-src 'self' data:; frame-src https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; connect-src 'self' https://api.stripe.com https://r.stripe.com https://challenges.cloudflare.com https://donation.api.progressivebyte.com https://hcusa.api.progressivebyte.com

# The embed page is meant to sit inside another site's page, so it must allow framing. Every other
# path keeps frame-ancestors 'none'. `! X-Frame-Options` removes the DENY set above for this path.
/donate/embed*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors *; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pub-387995532fb34284b3f927edc6088b7b.r2.dev; font-src 'self' data:; frame-src https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; connect-src 'self' https://api.stripe.com https://r.stripe.com https://challenges.cloudflare.com https://donation.api.progressivebyte.com https://hcusa.api.progressivebyte.com
